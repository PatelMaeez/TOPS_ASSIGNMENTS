3. Write a shell script automate_backup.sh that creates a backup of your /home directory and saves it with a timestamp in /backups.
=>executable script at /root/automate_backup.sh:
Bash#!/bin/bash
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="/backups"
BACKUP_FILE="${BACKUP_DIR}/home_backup_${TIMESTAMP}.tar.gz"

mkdir -p "$BACKUP_DIR"
tar -czf "$BACKUP_FILE" /home 2>/dev/null

if [ $? -eq 0 ]; then
    echo "$(date): Backup successful: $BACKUP_FILE"
    ls -lh "$BACKUP_FILE"
else
    echo "$(date): Backup failed"
    exit 1
fi
