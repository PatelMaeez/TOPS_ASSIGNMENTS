...
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ5zjViVVyZc5q8Gts/VtLN+Jjd23HOeAek6GpezVN0h testkey

cat /root/.ssh/id_ed25519.pub >> /home/testuser/.ssh/authorized_keys
chmod 600 /home/testuser/.ssh/authorized_keys
chown testuser:testuser /home/testuser/.ssh/authorized_keys
ls -la /home/testuser/.ssh/
ssh -i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o PasswordAuthentication=no testuser@localhost echo "Key-based SSH connection successful"

3. Edit the /etc/ssh/sshd_config file to disable password authentication by setting PasswordAuthentication no, then restart the sshd service and test that you can only log in using your SSH key.
=>sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config
grep PasswordAuthentication /etc/ssh/sshd_config
service ssh restart
# Password attempt (must fail)
sshpass -p 'password123' ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o PubkeyAuthentication=no testuser@localhost echo "Password worked" 2>&1 || true

# Key attempt (must succeed)
ssh -i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o PasswordAuthentication=no testuser@localhost echo "Key-based still works"

